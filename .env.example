# Copy to .env. No secrets are needed: the Elexon Insights API is public.
# DATA_MODE: auto | live | snapshot | synthetic
DATA_MODE=auto
# In auto mode, fall back to LABELLED synthetic data if Elexon is unreachable
ALLOW_SYNTHETIC_FALLBACK=true
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
# UNVERIFIED query parameter names - confirm against the live docs on first run
ELEXON_FROM_PARAM=publishDateTimeFrom
ELEXON_TO_PARAM=publishDateTimeTo
CUTOFF_TIMEZONE=Europe/London
# ASSUMPTION: previous day, 09:00 London time
CUTOFF_TIME=09:00
CUTOFF_LEAD_DAYS=1
MIN_AUTHORITATIVE_COVERAGE=0.95
CORS_ORIGINS=http://localhost:5173
